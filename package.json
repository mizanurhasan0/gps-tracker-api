{
  "name": "gps-tracker-api",
  "version": "1.0.0",
  "description": "GT06 GPS tracker server: TCP device listener, REST API and live Socket.IO updates",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "npm run build && node scripts/run-tests.cjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "npm run build && node --test --import tsx test/coordinates.test.ts test/gt06.codec.test.ts test/gt06.connection.test.ts test/history.math.test.ts",
    "migrate:legacy": "node scripts/import-legacy.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
