{
  "compilerOptions": {
    "module": "commonjs", //import export meaure
    "declaration": true, //generate .d.ts file which others project knows about your types.
    "removeComments": true, //remove comments in the output js file
    "emitDecoratorMetadata": true, //
    "experimentalDecorators": true, //enable decorator
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
