# Mandatory for host-run backend. Use URL-encoded credentials.
# For full Docker setup compose.yml constructs this URL with the postgres hostname.
DATABASE_URL=postgresql://gps_tracker:REPLACE_WITH_APP_PASSWORD@127.0.0.1:5432/gps_tracker

REST_PORT=3000
SOCKET_PORT=3001
TCP_HOST=0.0.0.0
TCP_PORT=5023
PUBLIC_HOST=127.0.0.1
ALLOWED_IMEIS=
ONLINE_THRESHOLD_MS=180000
CORS_ORIGIN=*
GPS_TIMEZONE_OFFSET_MINUTES=0

# Set two DIFFERENT generated hex passwords before starting Docker Compose.
# Neither password is provided by this repository.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
POSTGRES_PORT=5432

# First admin only; changing these does not reset an existing account.
ADMIN_PHONE=
ADMIN_PASSWORD=

# Explicit legacy import only; not used by the running API:
# LEGACY_DATA_DIR=/absolute/path/to/stopped-backup/data
# Dedicated disposable PostgreSQL database for integration tests:
# TEST_DATABASE_URL=postgresql://test_user:password@127.0.0.1:55432/test_db
