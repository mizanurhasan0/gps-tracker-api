# REST API port
REST_PORT=3000

# Socket.IO port for live location push
SOCKET_PORT=3001

# GT06 tracker TCP listener
TCP_HOST=0.0.0.0
TCP_PORT=5023

# Public address devices connect to (used in logs and SMS setup hints)
PUBLIC_HOST=147.79.71.98

# Comma separated allowlist. Leave empty to accept any IMEI.
ALLOWED_IMEIS=

# Device is "online" when seen within this window (ms)
ONLINE_THRESHOLD_MS=180000

# Allowed CORS origin for REST and Socket.IO
CORS_ORIGIN=*

# Where JSON persistence files are written
DATA_DIR=./data

# PostgreSQL stores GPS history. Keep this URL secret and the DB port private.
# Without this setting, live tracking continues and history queues durably in
# transport.sqlite; history queries return 503 until PostgreSQL is configured.
# DATABASE_URL=postgresql://gps_history:replace-me@127.0.0.1:5432/gps_history

# Device clock offset from UTC, NOT the dashboard display timezone.
# Default 0 assumes the tracker reports UTC. Verify with an actual device fix.
GPS_TIMEZONE_OFFSET_MINUTES=0

# First admin bootstrap (only when no admin exists). Never commit real credentials.
# ADMIN_PHONE=01XXXXXXXXX
# ADMIN_PASSWORD=choose-a-unique-password-at-least-12-characters
