# Mandatory for host-run backend. Use URL-encoded credentials.
# For full Docker setup compose.yml constructs this URL with the postgres hostname.
DATABASE_URL=postgresql://gps_tracker:REPLACE_WITH_APP_PASSWORD@127.0.0.1:5432/gps_tracker

REST_PORT=3000
SOCKET_PORT=3001
TCP_HOST=0.0.0.0
TCP_PORT=5023
PUBLIC_HOST=127.0.0.1
ALLOWED_IMEIS=
ONLINE_THRESHOLD_MS=180000
CORS_ORIGIN=*
GPS_TIMEZONE_OFFSET_MINUTES=0

# Set two DIFFERENT generated hex passwords before starting Docker Compose.
# Neither password is provided by this repository.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
POSTGRES_PORT=5432

# First admin only; changing these does not reset an existing account.
ADMIN_PHONE=
ADMIN_PASSWORD=

# Owner-bound admin recovery. Enable only after configuring Gmail App Password.
# First enabled startup permanently binds the only existing ADMIN account by ID.
ADMIN_RECOVERY_ENABLED=false
ADMIN_RECOVERY_EMAIL=eng.mizanur.hasan@gmail.com
# Generate with: openssl rand -hex 32. Keep outside Git and separate from backups.
ADMIN_RECOVERY_SECRET=
RECOVERY_SMTP_HOST=smtp.gmail.com
RECOVERY_SMTP_PORT=465
RECOVERY_SMTP_USER=eng.mizanur.hasan@gmail.com
# Gmail App Password, NOT your normal Google password. Never commit it.
RECOVERY_SMTP_PASSWORD=
RECOVERY_SMTP_FROM=eng.mizanur.hasan@gmail.com

# Telegram uses long polling; no public URL, HTTPS certificate, or webhook secret is needed.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Optional: used to create connect links. If empty, it is read securely from Telegram via getMe.
TELEGRAM_BOT_USERNAME=
TELEGRAM_POLL_TIMEOUT_SECONDS=50
TELEGRAM_GEOFENCE_RADIUS_METERS=100
TELEGRAM_GEOFENCE_TIME_WINDOW_MINUTES=15

# Explicit legacy import only; not used by the running API:
# LEGACY_DATA_DIR=/absolute/path/to/stopped-backup/data
# Dedicated disposable PostgreSQL database for integration tests:
# TEST_DATABASE_URL=postgresql://test_user:password@127.0.0.1:55432/test_db

# Encrypted PostgreSQL backup to Google Drive. Leave disabled until every
# required value is configured in the private deployment environment.
BACKUP_ENABLED=false
BACKUP_SCHEDULE_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=30
BACKUP_MAX_MIB=512
BACKUP_TIMEOUT_MINUTES=20
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_ENCRYPTION_KEY=
BACKUP_SMTP_HOST=smtp.gmail.com
BACKUP_SMTP_PORT=465
BACKUP_SMTP_USER=
BACKUP_SMTP_PASSWORD=
BACKUP_SMTP_FROM=
BACKUP_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
